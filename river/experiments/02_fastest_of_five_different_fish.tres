[gd_resource type="Resource" script_class="Experiment" format=3]

[ext_resource type="Script" path="res://river/scripts/experiment.gd" id="experiment"]
[ext_resource type="Script" path="res://river/scripts/river_task.gd" id="task"]
[ext_resource type="Script" path="res://river/scripts/river_object_config.gd" id="object"]
[ext_resource type="Script" path="res://river/scripts/reward_table.gd" id="reward_table"]
[ext_resource type="Script" path="res://river/scripts/reward_entry.gd" id="reward_entry"]
[ext_resource type="Resource" path="res://river/skins/lagoon/lagoon_skin.tres" id="lagoon"]

[sub_resource type="Resource" id="red"]
script = ExtResource("object")
name = &"red"
tags = PackedStringArray("red")
shape = "sphere"
color = Color(1, 0.12, 0.1, 1)
size = 0.6
swim_speed_m_per_s = 0.15
float_height = 0.08

[sub_resource type="Resource" id="yellow"]
script = ExtResource("object")
name = &"yellow"
tags = PackedStringArray("yellow")
shape = "box"
color = Color(1, 0.85, 0.1, 1)
size = 0.6
swim_speed_m_per_s = 0.3
float_height = 0.08

[sub_resource type="Resource" id="blue"]
script = ExtResource("object")
name = &"blue"
tags = PackedStringArray("blue")
shape = "cone"
color = Color(0.15, 0.4, 1, 1)
size = 0.6
swim_speed_m_per_s = 0.45
float_height = 0.08

[sub_resource type="Resource" id="green"]
script = ExtResource("object")
name = &"green"
tags = PackedStringArray("green")
shape = "cylinder"
color = Color(0.1, 0.8, 0.25, 1)
size = 0.6
swim_speed_m_per_s = 0.6
float_height = 0.08

[sub_resource type="Resource" id="white"]
script = ExtResource("object")
name = &"white"
tags = PackedStringArray("white")
shape = "torus"
color = Color(0.95, 0.95, 0.95, 1)
size = 0.6
swim_speed_m_per_s = 0.75
float_height = 0.08

[sub_resource type="Resource" id="catch_fastest"]
script = ExtResource("task")
question_text = "Catch the one that swims the FASTEST!"
correct_answer_rule = "fastest moving"
objects_in_trial = Array[ExtResource("object")]([SubResource("red"), SubResource("yellow"), SubResource("blue"), SubResource("green"), SubResource("white")])
repeat_times = 3

[sub_resource type="Resource" id="shell_per_catch"]
script = ExtResource("reward_entry")

[sub_resource type="Resource" id="rewards"]
script = ExtResource("reward_table")
entries = Array[ExtResource("reward_entry")]([SubResource("shell_per_catch")])

[resource]
script = ExtResource("experiment")
description = "Five different fish (shape and colour) swim at 0.15 to 0.75 m/s. Catch the fastest."
tasks = Array[ExtResource("task")]([SubResource("catch_fastest")])
look = ExtResource("lagoon")
show_time_on_correct = true
reward_table = SubResource("rewards")
