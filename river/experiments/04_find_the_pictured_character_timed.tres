[sub_resource type="Resource" id="find_this_one"]
script = ExtResource("task")
question_text = "Catch this one!"
correct_answer_rule = "same as reference"
objects_in_trial = Array[ExtResource("object")]([SubResource("adventurer"), SubResource("pirate"), SubResource("astronaut"), SubResource("matt"), SubResource("lis")])
repeat_times = 2
each_object_as_reference = true

[resource]
script = ExtResource("experiment")
description = "Same as 03, but the catch time is shown after each correct answer."
tasks = Array[ExtResource("task")]([SubResource("find_this_one")])
shuffle_trial_order = true
correct_text = "Hit!"
show_time_on_correct = true
end_text = "Thank you!"
