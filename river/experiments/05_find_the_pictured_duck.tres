[sub_resource type="Resource" id="still_standard"]
script = ExtResource("object")
name = &"standard"
scene = ExtResource("standard_model")
picture = ExtResource("standard_picture")
size = 0.9
swim_speed_m_per_s = 0.0
spin_speed_deg_per_s = 0.0
float_height = 0.4

