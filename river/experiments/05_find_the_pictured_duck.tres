[resource]
script = ExtResource("experiment")
description = "Six rubber ducks, still and spinning rounds. Spear the pictured one."
tasks = Array[ExtResource("task")]([SubResource("round1_still"), SubResource("round2_spin"), SubResource("round3_still"), SubResource("round4_spin"), SubResource("round5_still"), SubResource("round6_spin"), SubResource("round7_still"), SubResource("round8_spin")])
look = ExtResource("lagoon")
correct_text = "Yes!"
end_text = "Thank you!"
