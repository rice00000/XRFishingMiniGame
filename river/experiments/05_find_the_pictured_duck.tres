[sub_resource type="Resource" id="round1_still"]
script = ExtResource("task")
name = &"round1_still"
question_text = "Catch this one!"
correct_answer_rule = "same as reference"
objects_in_trial = Array[ExtResource("object")]([SubResource("still_standard"), SubResource("still_round_head"), SubResource("still_long_beak"), SubResource("still_raised_tail"), SubResource("still_small_wings"), SubResource("still_tall_head")])
reference_object = SubResource("still_standard")
retry_until_correct = true

