[gd_resource type="Resource" script_class="RiverTask" format=3]

[ext_resource type="Script" path="res://river/scripts/river_task.gd" id="1_task"]
[ext_resource type="Script" path="res://river/scripts/standard_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://river/scripts/spawn_pool.gd" id="3_pool"]
[ext_resource type="Resource" path="res://river/data/experiments/character_match/characters_pool.tres" id="4_pool"]
[ext_resource type="Resource" path="res://river/data/experiments/character_match/objects/adventurer.tres" id="5_target"]
[ext_resource type="Texture2D" path="res://river/data/experiments/character_match/images/adventurer.png" id="6_image"]

[sub_resource type="Resource" id="Resource_rule"]
script = ExtResource("2_rule")
kind = 4

[resource]
script = ExtResource("1_task")
id = &"find_adventurer"
text = "Catch this one!"
reference_image = ExtResource("6_image")
reference_object = ExtResource("5_target")
rule = SubResource("Resource_rule")
pools = Array[ExtResource("3_pool")]([ExtResource("4_pool")])
