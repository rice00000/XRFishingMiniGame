[gd_resource type="Resource" script_class="RewardTable" format=3]

[ext_resource type="Script" path="res://river/scripts/reward_table.gd" id="1_table"]
[ext_resource type="Script" path="res://river/scripts/reward_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Resource_any"]
script = ExtResource("2_entry")
item_id = &"shell"
quantity = 1

[sub_resource type="Resource" id="Resource_red"]
script = ExtResource("2_entry")
object_id = &"red_ball"
item_id = &"red_gem"
quantity = 1

[sub_resource type="Resource" id="Resource_still"]
script = ExtResource("2_entry")
pool_id = &"still"
item_id = &"star"
quantity = 2

[resource]
script = ExtResource("1_table")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_any"), SubResource("Resource_red"), SubResource("Resource_still")])
