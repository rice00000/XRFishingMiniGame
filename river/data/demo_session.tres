[gd_resource type="Resource" script_class="RiverSession" format=3]

[ext_resource type="Script" path="res://river/scripts/river_session.gd" id="1_session"]
[ext_resource type="Script" path="res://river/scripts/river_task.gd" id="2_task_script"]
[ext_resource type="Resource" path="res://river/data/rewards.tres" id="0_rewards"]
[ext_resource type="Resource" path="res://river/data/tasks/01_fastest_spin.tres" id="3_task"]
[ext_resource type="Resource" path="res://river/data/tasks/02_slowest_spin.tres" id="4_task"]
[ext_resource type="Resource" path="res://river/data/tasks/03_fastest_swim.tres" id="5_task"]
[ext_resource type="Resource" path="res://river/data/tasks/04_same_as_this.tres" id="6_task"]
[ext_resource type="Resource" path="res://river/data/tasks/05_stays_still.tres" id="7_task"]
[ext_resource type="Resource" path="res://river/data/tasks/06_red_one.tres" id="8_task"]

[resource]
script = ExtResource("1_session")
tasks = Array[ExtResource("2_task_script")]([ExtResource("3_task"), ExtResource("4_task"), ExtResource("5_task"), ExtResource("6_task"), ExtResource("7_task"), ExtResource("8_task")])
